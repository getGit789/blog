# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Session JWT signing secret. REQUIRED: the server
                          # refuses to boot with NODE_ENV=production if unset.
                          # Generate one with: openssl rand -hex 32

# ── Database ───────────────────────────────────────────────────
# Local dev: a file path (default ./local.db), no DB server needed.
# Deployed on Cloudflare: a Turso database, since Cloudflare Pages Functions
# run in Workers with no persistent filesystem. Same drizzle-orm/libsql driver
# either way, just point this at the libsql:// or https:// URL Turso gives you
# and set DATABASE_AUTH_TOKEN below.
DATABASE_URL=./local.db
DATABASE_AUTH_TOKEN=       # Turso auth token. Unused for a local file DB.

# ── Admin account ───────────────────────────────────────────────
# The single admin account is created by `npm run db:seed`, never through the
# UI: there is no registration endpoint and the login page shows no credential
# hints. The username is fixed at `damir` in db/seed.ts; the password comes
# from here.
#
# Re-running the seed upserts the account and resets the password to this
# value, so this is also how you recover a forgotten password locally.
# Seeding with NODE_ENV=production fails if this is empty or still "123456".
SEED_ADMIN_PASSWORD=

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Kimi OAuth, dormant) ───────────────────────────────
# Kimi OAuth is not mounted; local username and password auth is the only live
# sign-in path. These stay here for if it is ever wired up.
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)
OWNER_UNION_ID=           # Union ID of the app creator (Kimi OAuth only)
